{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "types": ["node"],
    "noEmit": true,
    "paths": { "@mssio/qpdf-wasm": ["./src/index.ts"] }
  },
  "include": ["src", "test", "examples", "vitest.config.ts", "playwright.config.ts"],
  "exclude": ["test/browser/fixtures"]
}

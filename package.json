{
  "name": "@mssio/qpdf-wasm",
  "version": "0.1.0",
  "description": "qpdf compiled to WebAssembly: merge, split, encrypt, decrypt, linearize and more, in a Web Worker, for any SPA or Node.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mssio/qpdf-wasm.git"
  },
  "homepage": "https://github.com/mssio/qpdf-wasm#readme",
  "bugs": {
    "url": "https://github.com/mssio/qpdf-wasm/issues"
  },
  "keywords": [
    "qpdf",
    "pdf",
    "wasm",
    "webassembly",
    "merge",
    "split",
    "encrypt",
    "decrypt",
    "linearize",
    "web-worker"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/worker.js"
  ],
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:wasm": "bash scripts/build-wasm.sh",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/copy-wasm.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:node": "vitest run test/node",
    "test:browser": "bash scripts/prepare-browser-fixtures.sh && playwright test",
    "lint:package": "publint --strict && attw --pack . --profile esm-only",
    "check:package": "node scripts/check-package.mjs",
    "check:readme": "node scripts/check-readme.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.1",
    "publint": "^0.3.25",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
